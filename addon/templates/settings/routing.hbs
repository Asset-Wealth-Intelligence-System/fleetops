<Layout::Section::Header @title={{t "literal.fleet-ops.fleet-ops-routing-tracking"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "common.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">
            <ContentPanel @title={{t "settings.routing.configure-routing"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "settings.routing.routing-service"}} @helpText={{t "settings.routing.routing-service-help-text"}}>
                    <Select
                        @value={{this.displayEngine}}
                        @options={{this.routeEngine.availableServices}}
                        @optionLabel="name"
                        @optionValue="key"
                        @onSelect={{fn (mut this.displayEngine)}}
                        @placeholder={{t "settings.routing.select-routing-service"}}
                        class="w-full"
                    />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.routing-optimization-engine"}} @helpText={{t "literal.fleet-ops.choose-which-engine-should-optimize-stop-order-b-a64d3"}}>
                    <Select
                        @value={{this.optimizationEngine}}
                        @options={{this.routeOptimization.availableServices}}
                        @optionLabel="name"
                        @optionValue="key"
                        @onSelect={{fn (mut this.optimizationEngine)}}
                        @placeholder={{t "literal.fleet-ops.select-route-optimization-engine"}}
                        class="w-full"
                    />
                </InputGroup>
                <InputGroup @name={{t "settings.routing.routing-distance-unit"}} @helpText={{t "settings.routing.routing-distance-unit-help-text"}}>
                    <Select
                        @value={{this.routingUnit}}
                        @options={{this.routingUnitOptions}}
                        @optionLabel="label"
                        @optionValue="value"
                        @onSelect={{fn (mut this.routingUnit)}}
                        @placeholder={{t "settings.routing.select-routing-distance-unit"}}
                        class="w-full"
                    />
                </InputGroup>
            </ContentPanel>
            <ContentPanel @title={{t "literal.fleet-ops.tracking-intelligence"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.fleet-ops.tracking-provider"}} @helpText={{t "literal.fleet-ops.choose-the-provider-used-for-live-tracking-intel-9cc6c"}}>
                    <Select
                        @value={{this.trackingProvider}}
                        @options={{this.trackingProviderOptions}}
                        @optionLabel="label"
                        @optionValue="value"
                        @onSelect={{fn (mut this.trackingProvider)}}
                        @placeholder={{t "literal.fleet-ops.select-tracking-provider"}}
                        class="w-full"
                    />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.fallback-providers"}} @helpText={{t "literal.fleet-ops.providers-used-when-the-selected-tracking-provid-777b7"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelectMultiple
                            @searchEnabled={{true}}
                            @searchField="label"
                            @options={{this.trackingProviderOptions}}
                            @selected={{this.selectedTrackingFallbackOptions}}
                            @onChange={{this.setTrackingFallbacks}}
                            @placeholder={{t "literal.fleet-ops.select-fallback-providers"}}
                            @triggerClass="form-select form-input flex-1"
                            as |provider|
                        >
                            {{provider.label}}
                        </PowerSelectMultiple>
                    </div>
                </InputGroup>
                <div class="flex justify-end">
                    <Button
                        @type="default"
                        @size="xs"
                        @icon={{if this.showTrackingAdvancedSettings "chevron-up" "chevron-down"}}
                        @text={{t "literal.fleet-ops.advanced-settings"}}
                        @onClick={{this.toggleTrackingAdvancedSettings}}
                    />
                </div>
                {{#if this.showTrackingAdvancedSettings}}
                    <div class="mt-2 space-y-4 rounded-md border border-gray-200 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800">
                        <InputGroup @name={{t "literal.fleet-ops.traffic-aware-eta"}} @helpText={{t "literal.fleet-ops.use-provider-traffic-data-when-supported"}}>
                            <Toggle @isToggled={{this.trackingTrafficEnabled}} @onToggle={{fn (mut this.trackingTrafficEnabled)}} />
                        </InputGroup>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <InputGroup @name={{t "literal.fleet-ops.summary-cache-ttl"}} @helpText={{t "literal.fleet-ops.seconds-to-cache-the-final-tracking-summary"}}>
                                <Input @type="number" @value={{this.trackingCacheTtlSeconds}} min="15" max="300" class="form-input w-full" />
                            </InputGroup>
                            <InputGroup @name={{t "literal.fleet-ops.route-cache-ttl"}} @helpText={{t "literal.fleet-ops.seconds-to-cache-provider-route-responses"}}>
                                <Input @type="number" @value={{this.trackingRouteCacheTtlSeconds}} min="60" max="1800" class="form-input w-full" />
                            </InputGroup>
                            <InputGroup @name={{t "literal.fleet-ops.stale-location-threshold"}} @helpText={{t "literal.fleet-ops.seconds-before-driver-location-is-marked-stale"}}>
                                <Input @type="number" @value={{this.trackingStaleLocationThresholdSeconds}} min="30" max="3600" class="form-input w-full" />
                            </InputGroup>
                            <InputGroup @name={{t "literal.fleet-ops.fallback-speed"}} @helpText={{t "literal.fleet-ops.kilometers-per-hour-used-by-the-calculated-provi-6ed6f"}}>
                                <Input @type="number" @value={{this.trackingDefaultVehicleSpeedKph}} min="1" max="160" class="form-input w-full" />
                            </InputGroup>
                        </div>
                    </div>
                {{/if}}
            </ContentPanel>
            <ContentPanel @title={{t "literal.fleet-ops.operational-alerts"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name={{t "literal.fleet-ops.late-departures"}} @helpText={{t "literal.fleet-ops.notify-when-an-order-has-not-departed-after-the-58c34"}}>
                    <Toggle @isToggled={{this.lateDepartureAlertsEnabled}} @onToggle={{fn (mut this.lateDepartureAlertsEnabled)}} />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.late-departure-grace-period"}} @helpText={{t "literal.fleet-ops.minutes-after-scheduled-pickup-before-the-order-70c77"}}>
                    <Input @type="number" @value={{this.lateDepartureGracePeriodMinutes}} min="0" max="1440" class="form-input w-full" />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.route-deviations"}} @helpText={{t "literal.fleet-ops.notify-when-tracked-vehicle-location-drifts-beyo-953f6"}}>
                    <Toggle @isToggled={{this.routeDeviationAlertsEnabled}} @onToggle={{fn (mut this.routeDeviationAlertsEnabled)}} />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.route-deviation-threshold"}} @helpText={{t "literal.fleet-ops.meters-from-the-active-route-before-a-deviation-4db7a"}}>
                    <Input @type="number" @value={{this.routeDeviationDistanceThresholdMeters}} min="0" max="100000" class="form-input w-full" />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.prolonged-stoppages"}} @helpText={{t "literal.fleet-ops.notify-when-a-vehicle-remains-stopped-beyond-the-4fd79"}}>
                    <Toggle @isToggled={{this.prolongedStoppageAlertsEnabled}} @onToggle={{fn (mut this.prolongedStoppageAlertsEnabled)}} />
                </InputGroup>
                <InputGroup @name={{t "literal.fleet-ops.prolonged-stoppage-duration"}} @helpText={{t "literal.fleet-ops.minutes-stopped-before-a-stoppage-alert-is-eligi-ce994"}}>
                    <Input @type="number" @value={{this.prolongedStoppageDurationThresholdMinutes}} min="0" max="1440" class="form-input w-full" />
                </InputGroup>
            </ContentPanel>
            <RegistryYield @registry="fleet-ops:template:settings:routing" as |RegistryComponent|>
                <RegistryComponent @controller={{this}} />
            </RegistryYield>
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>
