<Layout::Resource::Tabular
    @resource="sensor"
    @title={{t "resource.sensors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.sensorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="satellite-dish"
        title=(t "literal.fleet-ops.add-your-first-sensor")
        description=(t "literal.fleet-ops.sensors-capture-telemetry-signals-that-can-power-d6de1")
        filteredTitle=(t "literal.fleet-ops.no-sensors-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-sen-e63f2")
        primaryText=(t "literal.fleet-ops.new-sensor")
        primaryIcon="plus"
        primaryAction=this.sensorActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.sensorActions.import
        docsSlug="fleet-ops/connectivity/sensors/overview"
        docsTitle=(t "literal.fleet-ops.sensors-guide")
        docsText=(t "literal.fleet-ops.sensors-guide")
        docsSource="fleet-ops-empty-sensors"
    }}
/>
{{outlet}}
