<Layout::Resource::Tabular
    @resource="device-event"
    @title={{t "literal.fleet-ops.connectivity-events"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.deviceEventActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="bolt"
        title=(t "literal.fleet-ops.no-connectivity-events-yet")
        description=(t "literal.fleet-ops.events-appear-here-after-connected-devices-or-pr-ab56f")
        filteredTitle=(t "literal.fleet-ops.no-events-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-provider-device-or-date-filter-b7532")
        primaryText=(t "literal.fleet-ops.refresh")
        primaryIcon="refresh"
        primaryAction=this.deviceEventActions.refresh
        docsSlug="fleet-ops/connectivity/events/overview"
        docsTitle=(t "literal.fleet-ops.events-guide")
        docsText=(t "literal.fleet-ops.events-guide")
        docsSource="fleet-ops-empty-events"
    }}
/>
{{outlet}}
