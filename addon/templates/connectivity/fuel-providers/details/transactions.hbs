<div class="mx-auto w-full max-w-7xl px-4 py-4 md:px-6">
    <Layout::Resource::Tabular
        @resource="fuel-provider-transaction"
        @title={{t "literal.fleet-ops.imported-transactions"}}
        @data={{@model}}
        @columns={{this.columns}}
        @page={{1}}
        @controller={{this}}
        @emptyStateComponent={{component
            "table/empty-state"
            icon="receipt"
            title=(t "literal.fleet-ops.no-imported-transactions")
            description=(t "literal.fleet-ops.fuel-transactions-will-appear-here-after-this-pr-bbd70")
            filteredTitle=(t "literal.fleet-ops.no-transactions-match-your-filters")
            filteredDescription=(t "literal.fleet-ops.adjust-filters-or-sync-the-provider-again-to-rev-0de3c")
            primaryText=(t "literal.fleet-ops.refresh")
            primaryIcon="refresh"
            primaryAction=this.refresh
        }}
    />
</div>
