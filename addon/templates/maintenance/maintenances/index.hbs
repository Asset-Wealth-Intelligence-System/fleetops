<Layout::Resource::Tabular
    @resource="maintenance"
    @title={{t "resource.maintenances"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.maintenanceActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="screwdriver-wrench"
        title=(t "literal.fleet-ops.no-maintenance-records-yet")
        description=(t "literal.fleet-ops.log-maintenance-events-to-keep-service-history-c-f621f")
        filteredTitle=(t "literal.fleet-ops.no-maintenance-records-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-mai-591ad")
        primaryText=(t "literal.fleet-ops.new-maintenance")
        primaryIcon="plus"
        primaryAction=this.maintenanceActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.maintenanceActions.import
    }}
/>
{{outlet}}
