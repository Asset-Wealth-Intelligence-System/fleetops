<Layout::Resource::Tabular
    @resource="work-order"
    @title={{t "resource.work-orders"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.workOrderActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="clipboard-list"
        title=(t "literal.fleet-ops.no-work-orders-yet")
        description=(t "literal.fleet-ops.create-work-orders-to-assign-maintenance-tasks-t-b5c44")
        filteredTitle=(t "literal.fleet-ops.no-work-orders-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-wor-72893")
        primaryText=(t "literal.fleet-ops.new-work-order")
        primaryIcon="plus"
        primaryAction=this.workOrderActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.workOrderActions.import
        docsSlug="fleet-ops/maintenance/work-orders/overview"
        docsTitle=(t "literal.fleet-ops.work-orders-guide")
        docsText=(t "literal.fleet-ops.work-orders-guide")
        docsSource="fleet-ops-empty-work-orders"
    }}
/>
{{outlet}}
