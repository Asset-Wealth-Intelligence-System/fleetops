<Layout::Resource::Tabular
    @resource="place"
    @title={{t "resource.places"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.placeActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="location-dot"
        title=(t "literal.fleet-ops.add-your-first-place")
        description=(t "literal.fleet-ops.places-keep-frequent-pickup-dropoff-facility-and-17599")
        filteredTitle=(t "literal.fleet-ops.no-places-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-sav-bc812")
        primaryText=(t "literal.fleet-ops.new-place-41d8d")
        primaryIcon="plus"
        primaryAction=this.placeActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.placeActions.import
        docsSlug="fleet-ops/resources/places/overview"
        docsTitle=(t "literal.fleet-ops.places-guide")
        docsText=(t "literal.fleet-ops.places-guide")
        docsSource="fleet-ops-empty-places"
    }}
/>
{{outlet}}
