<Layout::Resource::Tabular
    @resource="contact"
    @title={{t "resource.contacts"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.contactActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="address-book"
        title=(t "literal.fleet-ops.add-your-first-contact")
        description=(t "literal.fleet-ops.contacts-keep-customer-vendor-and-internal-stake-87dfb")
        filteredTitle=(t "literal.fleet-ops.no-contacts-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-con-58dfd")
        primaryText=(t "literal.fleet-ops.new-contact")
        primaryIcon="plus"
        primaryAction=this.contactActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.contactActions.import
        docsSlug="fleet-ops/resources/contacts/overview"
        docsTitle=(t "literal.fleet-ops.contacts-guide")
        docsText=(t "literal.fleet-ops.contacts-guide")
        docsSource="fleet-ops-empty-contacts"
    }}
    @withoutHeader={{true}}
/>
{{outlet}}
