<Layout::Resource::Tabular
    @resource="contact"
    @title={{t "resource.customers"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.customerActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="user-group"
        title=(t "literal.fleet-ops.add-your-first-customer")
        description=(t "literal.fleet-ops.customers-give-orders-an-owner-contact-details-a-554da")
        filteredTitle=(t "literal.fleet-ops.no-customers-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-cus-8b55a")
        primaryText=(t "literal.fleet-ops.new-customer")
        primaryIcon="plus"
        primaryAction=this.customerActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.customerActions.import
    }}
    @withoutHeader={{true}}
/>
{{outlet}}
