<Layout::Resource::Tabular
    @resource="fleet"
    @title={{t "resource.fleets"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fleetActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="layer-group"
        title=(t "literal.fleet-ops.create-your-first-fleet")
        description=(t "literal.fleet-ops.fleets-help-group-vehicles-and-drivers-for-dispa-8efba")
        filteredTitle=(t "literal.fleet-ops.no-fleets-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-fle-e11f0")
        primaryText=(t "literal.fleet-ops.new-fleet")
        primaryIcon="plus"
        primaryAction=this.fleetActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.fleetActions.import
        docsSlug="fleet-ops/resources/fleets/overview"
        docsTitle=(t "literal.fleet-ops.fleets-guide")
        docsText=(t "literal.fleet-ops.fleet-guide")
        docsSource="fleet-ops-empty-fleets"
    }}
/>
{{outlet}}
