<Layout::Resource::Tabular
    @resource="vendor"
    @title={{t "resource.vendors"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.vendorActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="building"
        title=(t "literal.fleet-ops.add-your-first-vendor")
        description=(t "literal.fleet-ops.vendors-let-your-team-manage-external-carriers-s-47cb6")
        filteredTitle=(t "literal.fleet-ops.no-vendors-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-ven-44289")
        primaryText=(t "literal.fleet-ops.new-vendor")
        primaryIcon="plus"
        primaryAction=this.vendorActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.vendorActions.import
        docsSlug="fleet-ops/resources/vendors/overview"
        docsTitle=(t "literal.fleet-ops.vendors-guide")
        docsText=(t "literal.fleet-ops.vendor-guide")
        docsSource="fleet-ops-empty-vendors"
    }}
/>
{{outlet}}
