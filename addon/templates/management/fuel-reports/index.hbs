<Layout::Resource::Tabular
    @resource="fuel-report"
    @title={{t "resource.fuel-reports"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.fuelReportActions.controllerSearchTask this}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="gas-pump"
        title=(t "literal.fleet-ops.no-fuel-reports-yet")
        description=(t "literal.fleet-ops.create-fuel-reports-to-track-vehicle-fuel-usage-8631f")
        filteredTitle=(t "literal.fleet-ops.no-fuel-reports-match-your-filters")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-or-filters-to-find-another-fue-553d2")
        primaryText=(t "literal.fleet-ops.new-fuel-report")
        primaryIcon="plus"
        primaryAction=this.fuelReportActions.transition.create
        secondaryText=(t "literal.fleet-ops.import")
        secondaryIcon="upload"
        secondaryAction=this.fuelReportActions.import
        docsSlug="fleet-ops/resources/fuel-reports/overview"
        docsTitle=(t "literal.fleet-ops.fuel-reports-guide")
        docsText=(t "literal.fleet-ops.fuel-reports-guide")
        docsSource="fleet-ops-empty-fuel-reports"
    }}
/>
{{outlet}}
