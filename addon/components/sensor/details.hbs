<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "literal.fleet-ops.identity"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.name"}}</div>
                <div class="field-value">{{n-a @resource.name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.sensor-type"}}</div>
                <div class="field-value">{{n-a (get-fleet-ops-option-label "sensorTypes" @resource.type)}}</div>
            </div>

            <div></div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.unit"}}</div>
                <div class="field-value">{{n-a @resource.unit}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.internal-id"}}</div>
                <div class="field-value">{{n-a @resource.internal_id}}</div>
            </div>

            <div class="field-info-container col-span-2">
                <div class="field-name">{{t "literal.fleet-ops.serial-number"}}</div>
                <div class="field-value">{{n-a @resource.serial_number}}</div>
            </div>

        </div>
    </ContentPanel>

    <ContentPanel @title={{t "literal.fleet-ops.thresholds"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.minimum-threshold"}}</div>
                <div class="field-value">{{n-a @resource.min_threshold}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.maximum-threshold"}}</div>
                <div class="field-value">{{n-a @resource.max_threshold}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.threshold-inclusive"}}</div>
                <div class="field-value">
                    {{#if @resource.threshold_inclusive}}
                        <Badge @status="success">{{t "literal.fleet-ops.yes"}}</Badge>
                    {{else}}
                        <Badge @status="warning">{{t "literal.fleet-ops.no"}}</Badge>
                    {{/if}}
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.threshold-status"}}</div>
                <div class="field-value">
                    {{#if (eq @resource.threshold_status "normal")}}
                        <Badge @status="success">{{t "literal.fleet-ops.normal"}}</Badge>
                    {{else if (eq @resource.threshold_status "out_of_range")}}
                        <Badge @status="danger">{{t "literal.fleet-ops.out-of-range"}}</Badge>
                    {{else if (eq @resource.threshold_status "above_maximum")}}
                        <Badge @status="warning">{{t "literal.fleet-ops.above-maximum"}}</Badge>
                    {{else if (eq @resource.threshold_status "below_minimum")}}
                        <Badge @status="warning">{{t "literal.fleet-ops.below-minimum"}}</Badge>
                    {{else}}
                        <Badge @status="default">{{smart-humanize @resource.threshold_status}}</Badge>
                    {{/if}}
                </div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "literal.fleet-ops.readings"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.last-reading-at"}}</div>
                <div class="field-value">{{n-a (format-date @resource.last_reading_at)}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.report-frequency"}}</div>
                <div class="field-value">
                    {{#if @resource.report_frequency_sec}}
                        {{@resource.report_frequency_sec}}
                        seconds
                    {{else}}
                        {{n-a null}}
                    {{/if}}
                </div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "literal.fleet-ops.status-ec53a"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.status-ec53a"}}</div>
                <div class="field-value">
                    <Badge @status={{@resource.status}}>{{smart-humanize @resource.status}}</Badge>
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.active-status"}}</div>
                <div class="field-value">
                    {{#if @resource.is_active}}
                        <Badge @status="success">{{t "literal.fleet-ops.active"}}</Badge>
                    {{else}}
                        <Badge @status="warning">{{t "literal.fleet-ops.inactive"}}</Badge>
                    {{/if}}
                </div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "literal.fleet-ops.integration-associations"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.device"}}</div>
                <div class="field-value">{{n-a @resource.device.name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.warranty"}}</div>
                <div class="field-value">{{n-a @resource.warranty.name}}</div>
            </div>
        </div>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />
</div>