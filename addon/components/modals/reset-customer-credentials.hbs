<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="px-4 text-gray-900 dark:text-gray-50">
        <div class="mb-1 text-base font-semibold">
            {{t "literal.fleet-ops.you-are-about-to-reset-the-password-for"}}
            {{this.customer.name}}
        </div>
        <div class="text-sm mb-4">{{t "literal.fleet-ops.please-enter-the-new-password-and-confirm-it-bel-48d42"}}</div>
        <InputGroup>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <InputGroup @name={{t "literal.fleet-ops.new-password"}} @type="password" @value={{this.password}} @wrapperClass="mb-0i" />
                <InputGroup @name={{t "literal.fleet-ops.confirm-new-password"}} @type="password" @value={{this.confirmPassword}} @wrapperClass="mb-0i" />
            </div>
        </InputGroup>
        <InputGroup>
            <Checkbox @value={{this.sendCredentials}} @label={{t "literal.fleet-ops.send-password-credentials-to-customer"}} @onToggle={{fn (mut this.sendCredentials)}} @alignItems="center" @labelClass="mb-0i" />
        </InputGroup>
    </div>
</Modal::Default>