<div class="flex flex-row items-center px-5 py-2 border-b border-gray-200 dark:border-gray-700">
    <div>
        <Input @value={{this.query}} @type="text" class="form-input form-input-sm w-60" placeholder={{t "live-map-drawer.driver-listing.message"}} />
    </div>
</div>
<Table
    @rows={{this.filteredDrivers}}
    @columns={{this.columns}}
    @searchQuery={{this.query}}
    @emptyStateComponent={{component
        "table/empty-state"
        variant="compact"
        icon="id-card"
        title=(t "literal.fleet-ops.no-drivers-visible")
        description=(t "literal.fleet-ops.drivers-appear-here-when-they-are-available-in-t-1fbab")
        filteredTitle=(t "literal.fleet-ops.no-drivers-match-this-search")
        filteredDescription=(t "literal.fleet-ops.adjust-the-search-to-find-another-driver")
    }}
/>
