<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "literal.fleet-ops.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.provider-27703"}}</div>
                <div class="field-value">{{n-a @resource.provider}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.policy-number"}}</div>
                <div class="field-value">{{n-a @resource.policy_number}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.status-ec53a"}}</div>
                <div class="field-value">
                    {{#if @resource.is_active}}
                        <Badge @status="success">{{t "literal.fleet-ops.active"}}</Badge>
                    {{else if @resource.is_expired}}
                        <Badge @status="danger">{{t "literal.fleet-ops.expired"}}</Badge>
                    {{else}}
                        <Badge @status="default">{{t "literal.fleet-ops.inactive"}}</Badge>
                    {{/if}}
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.vendor"}}</div>
                <div class="field-value">{{n-a @resource.vendor_name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.subject"}}</div>
                <div class="field-value">{{n-a @resource.subject_name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.coverage-summary"}}</div>
                <div class="field-value">{{n-a @resource.coverage_summary}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.start-date"}}</div>
                <div class="field-value">{{format-date @resource.start_date}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.end-date"}}</div>
                <div class="field-value">{{format-date @resource.end_date}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "literal.fleet-ops.days-remaining"}}</div>
                <div class="field-value">
                    {{#if @resource.is_expired}}
                        <Badge @status="danger">{{t "literal.fleet-ops.expired"}}</Badge>
                    {{else if @resource.days_remaining}}
                        {{@resource.days_remaining}}
                        days
                        {{#if (lt @resource.days_remaining 30)}}
                            <Badge @status="warning">{{t "literal.fleet-ops.expiring-soon"}}</Badge>
                        {{/if}}
                    {{else}}
                        N/A
                    {{/if}}
                </div>
            </div>

            <div class="field-info-container col-span-3">
                <div class="field-name">{{t "literal.fleet-ops.terms"}}</div>
                <div class="field-value">{{n-a @resource.terms}}</div>
            </div>

            <div class="field-info-container col-span-3">
                <div class="field-name">{{t "literal.fleet-ops.policy-document"}}</div>
                <div class="field-value">{{n-a @resource.policy}}</div>
            </div>
        </div>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />
</div>