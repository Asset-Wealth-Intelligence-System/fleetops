<ContentPanel @title={{t "literal.fleet-ops.configure-map"}} @open={{true}} @wrapperClass="bordered-classic">
    <InputGroup @name={{t "literal.fleet-ops.default-map-provider"}} @helpText={{t "literal.fleet-ops.sets-the-default-map-provider-for-all-organizati-e65b4"}}>
        <Select
            class="w-full flex-1"
            @value={{this.mapProvider}}
            @options={{this.mapProviderOptions}}
            @optionLabel="label"
            @optionValue="value"
            @placeholder={{t "literal.fleet-ops.select-default-map-provider"}}
            @onSelect={{this.selectMapProvider}}
        />
    </InputGroup>
    <InputGroup @name={{t "literal.fleet-ops.google-map-id"}} @value={{this.googleMapsMapId}} @helpText={{t "literal.fleet-ops.required-for-google-advanced-markers-and-cloud-b-00d82"}} />
</ContentPanel>

<EmberWormhole @to="next-view-section-subheader-actions">
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "literal.fleet-ops.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @isLoading={{or this.saveSettings.isRunning this.loadSettings.isRunning}}
        @disabled={{this.saveSettings.isRunning}}
    />
</EmberWormhole>